# Copy this file to ".env" (same folder) and paste your OpenRouter key below.
# Never share the .env file or paste the key in chat.
OPENROUTER_API_KEY=

# Any OpenRouter model ID works. Cheap GLM options:
#   z-ai/glm-5.3-flash   (default, fast & cheap)
#   z-ai/glm-4.7  /  z-ai/glm-5  /  z-ai/glm-5.3   (smarter, pricier output)
OPENROUTER_MODEL=z-ai/glm-5.3-flash
